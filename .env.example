PORT=3001
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# Optional: only needed if the global or a user's AI provider is set to 'openrouter'
OPENROUTER_API_KEY=
JWT_SECRET=
NCM_API_URL=http://localhost:3002
FISH_TTS_KEY=
FISH_TTS_VOICE=073ff47193eb4f179da0d62e250bfd82
# Optional: only needed to enable dj_voices entries with provider: 'minimax'.
# Uses the domestic endpoint (api.minimaxi.com); GroupId is not required.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
YOUTUBE_API_KEY=
ADMIN_PASSWORD=
# Used to derive the AES-256-GCM key for encrypting user-provided API keys (BYO key feature).
# Required to enable BYO key; without it the feature stays disabled and PUT /api/profile/keys returns 503.
APP_ENCRYPTION_KEY=
